{
  "manifest_version": 3,
  "name": "BOM Inventory — LCSC Purchase",
  "version": "1.0.0",
  "description": "Import an LCSC product into BOM Inventory purchases and allocate it to projects.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png"}
}
